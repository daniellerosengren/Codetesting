Cell[CellGroupData[{

Cell["\<\
Calculate Log Likelihood of data over multiple OU trajectories;\
\>", "Subsubsection",
 CellChangeTimes->{{3.756124877716351*^9, 3.756124929973184*^9}, 
   3.756363559581347*^9, {3.756367155713482*^9, 3.75636716617949*^9}, 
   3.756374563519087*^9},
 ExpressionUUID -> "efaa7035-4473-41f9-b4c8-01e05fef196d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SampleLogLikelihood", "=", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[Delta]", ",", "\[CapitalDelta]", ",", "numberOfSamples", ",", 
       "Xdata"}], "}"}], ",", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"tab", ",", 
         RowBox[{"JJ", "=", 
          RowBox[{
           RowBox[{"Dimensions", "[", "Xdata", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"tab", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Block", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Xdatatemp", "=", 
                RowBox[{"Xdata", "[", 
                 RowBox[{"[", 
                  RowBox[{";;", ",", "jj"}], "]"}], "]"}]}], ",", "tr", ",", 
               "MyLikelihood1FreqSample", ",", "MyLikelihood2FreqSample"}], 
              "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Mod", "[", 
                  RowBox[{
                   RowBox[{"jj", "+", "$KernelID"}], ",", 
                   SuperscriptBox["2", "0"]}], "]"}], "\[Equal]", "0"}], ",", 
                RowBox[{
                 RowBox[{"SampleText", "[", 
                  RowBox[{"[", 
                   RowBox[{"$KernelID", "-", 
                    RowBox[{"SampleText", "[", 
                    RowBox[{"[", 
                    RowBox[{"-", "1"}], "]"}], "]"}]}], "]"}], "]"}], "=", 
                 RowBox[{"{", 
                  RowBox[{"\"\<\[CapitalDelta]=\>\"", ",", 
                   RowBox[{"\[CapitalDelta]", " ", 
                    FractionBox["T2", 
                    RowBox[{"2", "\[Pi]"}]]}], ",", 
                   "\"\<Remaining steps \>\"", ",", 
                   RowBox[{
                    RowBox[{"NumberOfFreqLeft", " ", "JJ"}], "-", "jj", "+", 
                    "1"}], ",", " ", "\"\< time to finish=\>\"", ",", 
                   RowBox[{"UnitConvert", "[", 
                    RowBox[{
                    RowBox[{"Quantity", "[", 
                    RowBox[{
                    RowBox[{
                    FractionBox[
                    RowBox[{
                    RowBox[{"SessionTime", "[", "]"}], "-", "start"}], 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Mod", "[", 
                    RowBox[{"NumberOfFreqLeft", ",", "2"}], "]"}], "JJ"}], 
                    "+", "jj", "-", "1", "+", "$MachineEpsilon"}]], 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"NumberOfFreqLeft", " ", "JJ"}], "-", "jj", "+", 
                    "1"}], ")"}]}], ",", "\"\<Seconds\>\""}], "]"}], ",", 
                    RowBox[{"MixedRadix", "[", 
                    RowBox[{
                    "\"\<Hours\>\"", ",", "\"\<Minutes\>\"", ",", 
                    "\"\<Seconds\>\""}], "]"}]}], "]"}]}], "}"}]}]}], "]"}], 
              ";", "\[IndentingNewLine]", 
              RowBox[{"tr", "=", 
               RowBox[{
               "generateOUamplitudes", "[", "numberOfSamples", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"MyLikelihood1FreqSample", "=", 
               RowBox[{"BayesStep", "[", 
                RowBox[{"Xdatatemp", ",", 
                 RowBox[{"probability", "[", 
                  RowBox[{"time", ",", "\[Delta]", ",", "0", " ", ",", "tr"}],
                   "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"MyLikelihood2FreqSample", "=", 
               RowBox[{"BayesStep", "[", 
                RowBox[{"Xdatatemp", ",", 
                 RowBox[{"probability", "[", 
                  RowBox[{
                  "time", ",", "\[Delta]", ",", "\[CapitalDelta]", ",", 
                   "tr"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
               "Are", " ", "there", " ", "two", " ", "frequencies", " ", "in",
                 " ", "the", " ", 
                RowBox[{"data", "?"}]}], "*)"}], "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"Mean", "[", 
                  SuperscriptBox["2", "MyLikelihood1FreqSample"], "]"}], "<", 
                 RowBox[{"Mean", "[", 
                  SuperscriptBox["2", "MyLikelihood2FreqSample"], "]"}]}], 
                ",", 
                RowBox[{
                 RowBox[{"Max", "[", "MyLikelihood1FreqSample", "]"}], "<", 
                 RowBox[{"Max", "[", "MyLikelihood2FreqSample", "]"}]}], ",", 
                RowBox[{
                "HistogramList", "[", "MyLikelihood1FreqSample", "]"}], ",", 
                RowBox[{
                "HistogramList", "[", "MyLikelihood2FreqSample", "]"}], ",", 
                RowBox[{"Log2", "[", 
                 RowBox[{"Mean", "[", 
                  SuperscriptBox["2", "MyLikelihood1FreqSample"], "]"}], 
                 "]"}], ",", 
                RowBox[{"Log2", "[", 
                 RowBox[{"Mean", "[", 
                  SuperscriptBox["2", "MyLikelihood2FreqSample"], "]"}], 
                 "]"}], ",", 
                RowBox[{"Max", "[", "MyLikelihood1FreqSample", "]"}], ",", 
                RowBox[{"Max", "[", "MyLikelihood2FreqSample", "]"}]}], 
               "}"}]}]}], "\[IndentingNewLine]", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"jj", ",", "1", ",", "JJ"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<MeanEst\>\"", "\[Rule]", 
           RowBox[{"Boole", "[", 
            RowBox[{"tab", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "1"}], "]"}], "]"}], "]"}]}], ",", 
          RowBox[{"\"\<MaxEst\>\"", "\[Rule]", 
           RowBox[{"Boole", "[", 
            RowBox[{"tab", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "2"}], "]"}], "]"}], "]"}]}], ",", 
          RowBox[{"\"\<HistListOneFreqSample\>\"", "\[Rule]", 
           RowBox[{"tab", "[", 
            RowBox[{"[", 
             RowBox[{";;", ",", "3"}], "]"}], "]"}]}], ",", 
          RowBox[{"\"\<HistListTwoFreqSample\>\"", "\[Rule]", 
           RowBox[{"tab", "[", 
            RowBox[{"[", 
             RowBox[{";;", ",", "4"}], "]"}], "]"}]}]}], "|>"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.756124929973317*^9, 3.756124994961821*^9}, 
