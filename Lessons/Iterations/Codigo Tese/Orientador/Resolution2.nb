Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"nT2", "=", "20"}], ",", 
       RowBox[{"time", "=", 
        RowBox[{"Range", "[", 
         RowBox[{"20", " ", "T2"}], "]"}]}], ",", 
       RowBox[{"cutoff", "=", "4"}], ",", "a", ",", "p", ",", "x", ",", "pl1",
        ",", "pl2", ",", "pl3", ",", "pl4", ",", "corr"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"amp", "=", 
       RowBox[{"Timing", "[", 
        RowBox[{"generateOUamplitudes", "[", "1", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<time=\>\"", ",", 
         RowBox[{"amp", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<Dimensions=[amp]\>\"", 
         ",", 
         RowBox[{"Dimensions", "[", 
          RowBox[{"amp", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"amp", "=", 
       RowBox[{"amp", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"p", "=", 
       RowBox[{"Timing", "[", 
        RowBox[{"probability", "[", 
         RowBox[{"time", ",", 
          RowBox[{"6", " ", 
           FractionBox[
            RowBox[{"2", " ", "\[Pi]"}], "T2"]}], ",", 
          RowBox[{"1", " ", 
           FractionBox[
            RowBox[{"2", " ", "\[Pi]"}], "T2"]}], ",", "amp"}], "]"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<time=\>\"", ",", 
         RowBox[{"p", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<Dimensions[ptemp]=\>\"", 
         ",", 
         RowBox[{"Dimensions", "[", 
          RowBox[{"p", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"p", "=", 
       RowBox[{"p", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"x", "=", 
       RowBox[{"Timing", "[", 
        RowBox[{"Meas", "[", "p", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<time=\>\"", ",", 
         RowBox[{"x", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<Dimensions[xtemp]=\>\"", 
         ",", 
         RowBox[{"Dimensions", "[", 
          RowBox[{"x", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"x", "=", 
       RowBox[{"x", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"pl1", "=", 
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", "amp", "]"}], ",", 
         RowBox[{"Filling", "\[Rule]", "Axis"}], ",", 
         RowBox[{"AxesLabel", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"\"\<t[\[Tau]]\>\"", ",", "\"\<OU Amplitudes\>\""}], 
           "}"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"pl2", "=", 
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", "p", "]"}], ",", 
         RowBox[{"PlotRange", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}], ",", 
         RowBox[{"Filling", "\[Rule]", "0.5"}], ",", 
         RowBox[{"AxesLabel", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
           "\"\<t[\[Tau]]\>\"", ",", 
            "\"\<Probability for measurement outcome\>\""}], "}"}]}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"corr", "=", 
       RowBox[{"Timing", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"CovarianceFunction", "[", 
            RowBox[{
             RowBox[{"x", "[", 
              RowBox[{"[", 
               RowBox[{";;", ",", "1"}], "]"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"cutoff", " ", "T2"}], "}"}]}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ")"}], 
         FractionBox[
          RowBox[{"T2", " ", "nT2"}], 
          RowBox[{"Range", "[", 
           RowBox[{
            RowBox[{"T2", " ", "nT2"}], ",", 
            RowBox[{
             RowBox[{"T2", " ", 
              RowBox[{"(", 
               RowBox[{"nT2", "-", "cutoff"}], ")"}]}], "+", "1"}], ",", 
            RowBox[{"-", "1"}]}], "]"}]]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<time=\>\"", ",", 
         RowBox[{"corr", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         "\"\<Dimensions=[corrtemp]\>\"", ",", 
         RowBox[{"Dimensions", "[", 
          RowBox[{"corr", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"corr", "=", 
       RowBox[{"corr", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"pl3", "=", 
       RowBox[{"ListLinePlot", "[", 
        RowBox[{"corr", ",", 
         RowBox[{"Filling", "\[Rule]", "Axis"}], ",", 
         RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
         RowBox[{"AxesLabel", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
           "\"\<\[CapitalDelta]t[\[Tau]]\>\"", ",", 
            "\"\<Correlation Function\>\""}], "}"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pl4", "=", 
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            FractionBox[
             RowBox[{"Range", "[", 
              RowBox[{"0", ",", 
               RowBox[{"40", "-", "1"}]}], "]"}], "cutoff"], ",", 
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"Fourier", "[", "corr", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{";;", "40"}], "]"}], "]"}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Filling", "\[Rule]", "Axis"}], ",", 
         RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", 
         RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
         RowBox[{"AxesLabel", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"\"\<Frequency a.u.\>\"", ",", "\"\<Power Spectrum\>\""}], 
           "}"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"GraphicsGrid", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"pl1", ",", "pl2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"pl3", ",", "pl4"}], "}"}]}], "}"}], ",", 
         RowBox[{"ImageSize", "\[Rule]", "Full"}]}], "]"}], "]"}], ";"}]}], 
    "]"}], ";"}], "*)"}]], "Input",
