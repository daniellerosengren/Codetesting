Cell[BoxData[{
 RowBox[{
  RowBox[{"generateOUamplitudes", "=", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", "n", "}"}], ",", 
     RowBox[{"Transpose", "[", 
      RowBox[{
       RowBox[{"RandomFunction", "[", 
        RowBox[{
         RowBox[{"ARProcess", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Exp", "[", 
             RowBox[{"-", 
              FractionBox["1", "T2"]}], "]"}], "}"}], ",", 
           RowBox[{
            FractionBox["2", "\[Pi]"], 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"Exp", "[", 
               RowBox[{
                RowBox[{"-", "2"}], 
                FractionBox["1", "T2"]}], "]"}]}], ")"}], 
            SuperscriptBox[
             RowBox[{"(", 
              FractionBox["\[Pi]", "10"], ")"}], "2"]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{
            RowBox[{"nT2", " ", "T2"}], "-", "1"}]}], "}"}], " ", ",", 
         RowBox[{"4", " ", "n"}]}], "]"}], "[", "\"\<ValueList\>\"", "]"}], 
      "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ou", ",", "prob", ",", "x", ",", "logL"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ou", "=", 
        RowBox[{"generateOUamplitudes", "[", 
         SuperscriptBox["2", "10"], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"ou", "//", "Dimensions"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"prob", "=", 
        RowBox[{"probability", "[", 
         RowBox[{"time", ",", "2", ",", "3", ",", "ou"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"x", "=", 
        RowBox[{"Meas", "[", "prob", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"x", "//", "Dimensions"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"logL", "=", 
        RowBox[{"BayesStep", "[", 
         RowBox[{
          RowBox[{"x", "[", 
           RowBox[{"[", 
            RowBox[{";;", ",", "1"}], "]"}], "]"}], ",", "prob"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"logL", "//", "Dimensions"}], "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "*)"}]}]}], "Input",
