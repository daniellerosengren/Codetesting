Cell[BoxData[
 RowBox[{
  RowBox[{"IterationOverMeasurements", "=", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[CapitalDelta]", ",", "numberOfIterations", ",", "numberOfSamples"}], 
      "}"}], ",", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ou", ",", 
         RowBox[{"\[Delta]", "=", 
          RowBox[{"4", 
           RowBox[{"Exp", "[", "3", "]"}], 
           FractionBox[
            RowBox[{"2", " ", "\[Pi]"}], "T2"]}]}], ",", "x", ",", "Est", ",", 
         RowBox[{"start", "=", 
          RowBox[{"SessionTime", "[", "]"}]}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"NumberOfFreqLeft", "=", "2"}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"one", " ", "freq", " ", "data"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"x", "=", 
         RowBox[{"Meas", "[", 
          RowBox[{"probability", "[", 
           RowBox[{"time", ",", "\[Delta]", ",", "0", ",", 
            RowBox[{
            "generateOUamplitudes", "[", "numberOfIterations", "]"}]}], "]"}],
           "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Est", "=", 
         RowBox[{"<|", 
          RowBox[{"\"\<OneFreqData\>\"", "\[Rule]", 
           RowBox[{"SampleLogLikelihood", "[", 
            RowBox[{
            "\[Delta]", ",", "\[CapitalDelta]", ",", "numberOfSamples", ",", 
             "x"}], "]"}]}], "|>"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"NumberOfFreqLeft", "=", "1"}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"two", " ", "freq", " ", "data"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"x", "=", 
         RowBox[{"Meas", "[", 
          RowBox[{"probability", "[", 
           RowBox[{"time", ",", "\[Delta]", ",", "\[CapitalDelta]", ",", 
            RowBox[{
            "generateOUamplitudes", "[", "numberOfIterations", "]"}]}], "]"}],
           "]"}]}], ";", 
        RowBox[{"Est", "=", 
         RowBox[{"Append", "[", 
          RowBox[{"Est", ",", 
           RowBox[{"\"\<TwoFreqData\>\"", "\[Rule]", 
            RowBox[{"SampleLogLikelihood", "[", 
             RowBox[{
             "\[Delta]", ",", "\[CapitalDelta]", ",", "numberOfSamples", ",", 
              "x"}], "]"}]}]}], "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}], 
    "]"}]}], ";"}]], "Input",
